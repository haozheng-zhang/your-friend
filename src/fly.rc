#include <windows.h>
#include "resource.h"

IDR_FLY_FLIGHT RCDATA "../assets/fly-flight.png"
IDR_FLY_GROOM RCDATA "../assets/fly-groom.png"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
 FILEVERSION 1,1,1,0
 PRODUCTVERSION 1,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "OpenAI Codex\0"
      VALUE "FileDescription", "Desktop Fly - five minute animation\0"
      VALUE "FileVersion", "1.1.1\0"
      VALUE "InternalName", "DesktopFly.exe\0"
      VALUE "OriginalFilename", "DesktopFly_5min.exe\0"
      VALUE "ProductName", "Desktop Fly\0"
      VALUE "ProductVersion", "1.1.1\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
